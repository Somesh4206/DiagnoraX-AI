// DiagnoraX AI — Prisma schema (fresh rebuild)
// A single HealthRecord table is the source of truth for the app's history,
// stats and trend views.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// One row per completed analysis run.
//   type: "SYMPTOM_CHECK" | "BODY_ANALYSIS"
//   severity: SYMPTOM_CHECK → urgency level (emergency|urgent|routine|low)
//             BODY_ANALYSIS → BMI category label
//   data: full structured payload as JSON (SQLite has no list types).
model HealthRecord {
  id        String   @id @default(cuid())
  type      String
  title     String
  summary   String
  severity  String?
  data      String
  createdAt DateTime @default(now())

  @@index([type, createdAt])
}
