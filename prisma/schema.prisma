// DiagnoraX AI — Prisma schema (SQLite)
// Health records are the single source of truth for the symptom checker,
// body analysis, dashboard stats and history views.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// One row per analysis run (AI symptom check or deterministic body analysis).
// `data` holds the full structured payload as JSON (SQLite has no list types).
model HealthRecord {
  id        String   @id @default(cuid())
  // "SYMPTOM_CHECK" | "BODY_ANALYSIS"
  type      String
  title     String
  summary   String
  // SYMPTOM_CHECK → urgency level ("emergency" | "urgent" | "routine" | "low")
  // BODY_ANALYSIS → BMI category label
  severity  String?
  // full structured payload as JSON (analysis or result object + input echo)
  data      String
  createdAt DateTime @default(now())

  @@index([type, createdAt])
}
